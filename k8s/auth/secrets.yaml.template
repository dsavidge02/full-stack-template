# Template for creating Kubernetes Secret for auth service
# DO NOT commit actual secrets to version control
#
# Create this secret manually using kubectl:
# kubectl create secret generic auth-secrets \
#   --from-literal=MONGO_URI='<your-mongo-uri>' \
#   --from-literal=REFRESH_TOKEN_SECRET='<your-refresh-token-secret>'
#
# To update an existing secret:
# kubectl create secret generic auth-secrets \
#   --from-literal=MONGO_URI='<your-mongo-uri>' \
#   --from-literal=REFRESH_TOKEN_SECRET='<your-refresh-token-secret>' \
#   --dry-run=client -o yaml | kubectl apply -f -
#
# Or create from a file (recommended for sensitive values):
# kubectl create secret generic auth-secrets \
#   --from-literal=MONGO_URI=$(cat mongo-uri.txt) \
#   --from-literal=REFRESH_TOKEN_SECRET=$(cat refresh-token-secret.txt)

apiVersion: v1
kind: Secret
metadata:
  name: auth-secrets
  namespace: default
type: Opaque
stringData:
  MONGO_URI: "<replace-with-actual-mongo-uri>"
  REFRESH_TOKEN_SECRET: "<replace-with-actual-refresh-token-secret>"


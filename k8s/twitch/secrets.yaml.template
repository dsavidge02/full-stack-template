# Template for creating Kubernetes Secret for twitch service
# DO NOT commit actual secrets to version control
#
# Create this secret manually using kubectl:
# kubectl create secret generic twitch-secrets \
#   --from-literal=TWITCH_CLIENT_ID='<your-twitch-client-id>' \
#   --from-literal=TWITCH_CLIENT_SECRET='<your-twitch-client-secret>' \
#   --from-literal=TWITCH_REDIRECT_URI='<your-twitch-redirect-uri>'
#
# To update an existing secret:
# kubectl create secret generic twitch-secrets \
#   --from-literal=TWITCH_CLIENT_ID='<your-twitch-client-id>' \
#   --from-literal=TWITCH_CLIENT_SECRET='<your-twitch-client-secret>' \
#   --from-literal=TWITCH_REDIRECT_URI='<your-twitch-redirect-uri>' \
#   --dry-run=client -o yaml | kubectl apply -f -
#
# Or create from a file (recommended for sensitive values):
# kubectl create secret generic twitch-secrets \
#   --from-literal=TWITCH_CLIENT_ID=$(cat twitch-client-id.txt) \
#   --from-literal=TWITCH_CLIENT_SECRET=$(cat twitch-client-secret.txt) \
#   --from-literal=TWITCH_REDIRECT_URI=$(cat twitch-redirect-uri.txt)

apiVersion: v1
kind: Secret
metadata:
  name: twitch-secrets
  namespace: default
type: Opaque
stringData:
  TWITCH_CLIENT_ID: "<replace-with-actual-twitch-client-id>"
  TWITCH_CLIENT_SECRET: "<replace-with-actual-twitch-client-secret>"
  TWITCH_REDIRECT_URI: "<replace-with-actual-twitch-redirect-uri>"

